# 复制为 hub/config.local.yaml（gitignored）；也可使用明确的 --config 文件。
# 每个凭证至少32字符，App与节点必须不同。生产建议用环境替换。
host: 127.0.0.1
port: 18300
root_path: ""  # 经 /xvis/ 反代部署时设为 /xvis
db_path: hub/data/dsh-hub.db
app_token: "${XVIS_APP_TOKEN}"
node_tokens:
  mac-a: "${XVIS_NODE_TOKEN}"
node_names:
  mac-a: "我的 Mac"
log_level: INFO
node_heartbeat_timeout_sec: 45
node_scan_interval_sec: 5
default_timeout_sec: 1800
task_create_per_minute: 30
apns:
  enabled: false
  # environment: sandbox
  # topic: com.example.XVIS
  # certfile: /absolute/private/apns-cert.pem
  # keyfile: /absolute/private/apns-key.pem
